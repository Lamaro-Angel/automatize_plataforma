# Valores da Automatize para acrescentar ao .env do DeskcommCRM depois do install.sh.
# Nunca escrever chaves reais aqui: este ficheiro vai para o GitHub.

# Marca (lida em tempo real, não exige reconstruir)
APP_NAME=Automatize
APP_LOGO_URL=https://automatize-rho.vercel.app/brand/automatize-ao-lado-lilas.svg

# Endereço público do painel (trocar pelo domínio definitivo)
NEXT_PUBLIC_APP_URL=https://painel.automatize.ao

# Inteligência artificial: Claude (Anthropic) direto.
# A chave também pode ser posta na tela Agente de IA › Provedores (fica cifrada na base de dados).
ANTHROPIC_API_KEY=

# Canal oficial da Meta: o caminho recomendado é a tela Admin › API Oficial (Meta),
# que guarda o App Secret cifrado e gera o verify token sozinha.
# Estas linhas são só reserva, caso não se use a tela.
META_APP_ID=
META_APP_SECRET=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_SYSTEM_USER_TOKEN=
